# mcp-web 本地部署环境变量示例（复制为 .env 或设置为系统环境变量）

# HTTP 模式 Bearer Token（对外/局域网务必设置）
MCP_WEB_HTTP_TOKEN=change-me

# 本地文件白名单根目录（; 或 , 分隔）
MCP_WEB_ALLOWED_ROOTS=D:\projects;D:\web

# 无头模式（true/false）
MCP_WEB_HEADLESS=true

# web_download 默认下载目录
# MCP_WEB_DOWNLOADS_DIR=D:\mcp-web\downloads

# 部署模式：local（默认）/ cloud（服务器：强制无头、禁中继）
MCP_WEB_DEPLOY_MODE=local

# 授权（商业化）：license.lic + license.pub
# MCP_WEB_LICENSE_REQUIRED=false
# MCP_WEB_LICENSE_FILE=D:\mcp-web\license.lic
# MCP_WEB_LICENSE_PUBKEY_FILE=D:\mcp-web\license.pub

# 可选：HTTP 代理 / SOCKS5（静态内核）
# MCP_WEB_HTTP_PROXY=http://127.0.0.1:7890
